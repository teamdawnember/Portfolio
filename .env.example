# ── Contact-form email (Express + Nodemailer via Zoho SMTP) ──────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored and
# must never be committed.

# Zoho SMTP host — use smtp.zoho.in for accounts created on Zoho India (.in),
# or smtp.zoho.com for Zoho global (.com). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true

# The Zoho mailbox that sends the mail, and an APP-SPECIFIC PASSWORD
# (NOT your normal login password).
# Create one: Zoho Mail → Settings → Security → App Passwords → Generate New.
SMTP_USER=hello@dawnember.in
SMTP_PASS=paste-your-zoho-app-password-here

# Inbox that receives the enquiries, and the visible "From" line.
MAIL_TO=hello@dawnember.in
MAIL_FROM="DawnEmber Website <hello@dawnember.in>"

# Port the API server listens on (the Vite dev proxy forwards /api → this).
PORT=3001

# Production: comma-separated browser origins allowed to call the API.
# Leave blank for local dev. e.g. https://dawnember.in,https://www.dawnember.in
ALLOWED_ORIGIN=

# Optional (frontend): base URL of the API in production if it is served on a
# DIFFERENT origin than the site. Leave unset when same-origin / using a proxy.
# VITE_API_BASE=https://api.dawnember.in